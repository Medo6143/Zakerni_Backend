# ---- Infra (docker-compose) ----
POSTGRES_DB=zakerni
POSTGRES_USER=zakerni
POSTGRES_PASSWORD=zakerni
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DATABASE_URL=postgres://zakerni:zakerni@localhost:5432/zakerni
REDIS_URL=redis://localhost:6379/0
DEFAULT_TIMEZONE=Africa/Cairo

# Fernet key for encrypting Moodle tokens:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Moodle (AOU Egypt) ----
MOODLE_BASE_URL=https://egylms.arabou.edu.kw
MOODLE_SERVICE=moodle_mobile_app
MOODLE_SYNC_INTERVAL_MINUTES=30
MOODLE_HTTP_TIMEOUT_SECONDS=10

# ---- SIS (AOU Egypt Student Information System) ----
# Values come from the public SIS web client configuration
# (https://sisegy.arabou.edu.kw/spegy/, main.*.js: apiUrl, branchId, apiTokenUserId,
# apiTokenUsername, apiTokenUserPassword). Copy them into your local .env; never commit them.
SIS_API_BASE_URL=
SIS_APP_USER_ID=
SIS_APP_USERNAME=
SIS_APP_PASSWORD=
SIS_BRANCH_ID=
SIS_SYNC_INTERVAL_MINUTES=360
SIS_HTTP_TIMEOUT_SECONDS=10

# ---- Phone-side sync ----
# Enables POST /me/sis/ingest: the phone reads the SIS (it only answers from Egypt) and posts the schedule
SIS_INGEST_ENABLED=false

# ---- Schedule / reminders ----
REMINDER_DISPATCH_BATCH_SIZE=500
REMINDER_MAX_ATTEMPTS=3
REMINDER_RETRY_DELAY_MINUTES=2
# Reminders more than this many minutes late are skipped instead of sent
REMINDER_SKIP_LATE_MINUTES=30
# Finished reminder rows older than this are deleted by the daily cleanup
REMINDER_HISTORY_RETENTION_DAYS=90

# ---- Firebase Cloud Messaging ----
# Path to the service-account JSON downloaded from Firebase console
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json
# Alternative (Railway): the whole service-account JSON on one line. Wins over the file.
FIREBASE_CREDENTIALS_JSON=
FCM_HTTP_TIMEOUT_SECONDS=10

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ZakerniBot
# Sent by Telegram in X-Telegram-Bot-Api-Secret-Token; set the same value in setWebhook.
# The webhook rejects every request while this is empty.
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10
TELEGRAM_HTTP_TIMEOUT_SECONDS=10

# ---- App meta (GET /api/v1/meta/app) ----
APP_MIN_SUPPORTED_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_PRIVACY_URL=
APP_SUPPORT_TELEGRAM=
APP_DEVELOPER_NAME=

# ---- API / CORS ----
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

# ---- Media storage (report attachments) ----
# cloudinary://<api_key>:<api_secret>@<cloud_name>; empty = local MEDIA_ROOT
CLOUDINARY_URL=

# ---- Production only (config.settings.prod) ----
# Comma-separated, e.g. https://api.example.com; the Railway domain is added automatically
CSRF_TRUSTED_ORIGINS=
# Set by Railway automatically; listed for completeness
RAILWAY_PUBLIC_DOMAIN=
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
LOG_LEVEL=

# ---- Logging ----
DJANGO_LOG_LEVEL=INFO
